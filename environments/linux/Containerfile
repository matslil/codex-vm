FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       git \
       python3 \
       python3-venv \
       unzip \
       xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY run /environment/run
RUN chmod 0755 /environment/run

WORKDIR /job/workspace
ENTRYPOINT ["/environment/run"]

